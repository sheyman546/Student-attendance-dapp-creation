# ===================================
# Student Attendance dApp — .env.example
# ===================================
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
#
# WARNING: Never commit real secrets to version control.
# ===================================

# --- Smart Contract ---
# Deployed ProofStorage contract address on your network
NEXT_PUBLIC_PROOF_ADDRESS=0x0000000000000000000000000000000000000000

# RPC URL for read-only contract queries (mainnet, testnet, or local)
# Use a provider like Alchemy, Infura, or your local Anvil/Hardhat node
NEXT_PUBLIC_RPC_URL=http://localhost:8545

# --- Database (Prisma) ---
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/attendance

# --- Deployment (Foundry) ---
# Deployer private key (used by forge script DeployProofStorage.s.sol)
# IMPORTANT: Use a dedicated dev wallet — never your main wallet
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
