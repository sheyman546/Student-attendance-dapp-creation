[TEMPLATE]
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/attendance"

# Private key of the contract owner / admin.
# The server uses this to sign on-chain transactions (registering students
# whose pending records are linked, and legacy proof attestation).
PRIVATE_KEY="0x..."

# RPC endpoint for the chain the ProofStorage contract is deployed on
# (e.g. a Sepolia endpoint from Infura / Alchemy)
RPC_URL="https://sepolia.infura.io/v3/YOUR_PROJECT_ID"

# Address of the deployed ProofStorage contract (public, safe to expose)
NEXT_PUBLIC_PROOF_ADDRESS="0x..."

# Block explorer base URL used to link transaction hashes on the portals.
# Optional — links are hidden when unset.
#NEXT_PUBLIC_EXPLORER_URL="https://sepolia.etherscan.io"

# Per-wallet rate limiting for POST /api/attendance (in-memory sliding window).
# Caps how often one wallet can hit the endpoint so a spammer can't spam the
# server. Optional — sane defaults below.
ATTENDANCE_RATE_LIMIT_MAX=5
ATTENDANCE_RATE_LIMIT_WINDOW_MS=60000

# ---- Teacher (Gmail) login ----
# Google OAuth app credentials. Create them at
# https://console.cloud.google.com/apis/credentials and add
#   http://localhost:3000/api/auth/google/callback
# as an Authorized redirect URI. Optional — wallet login works without it.
#GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
#GOOGLE_CLIENT_SECRET="GOCSPX-..."

# Emails allowed to sign in as teachers via Google (comma separated).
# Teachers managed from the admin dashboard are also allowed.
#TEACHER_EMAILS="teacher@school.edu,admin@school.edu"

# Secret used to sign teacher session cookies. Set to a long random string.
# When unset, it is derived from PRIVATE_KEY.
#SESSION_SECRET="change-me-to-a-long-random-string"
